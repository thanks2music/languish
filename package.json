{
  "name": "languish",
  "version": "0.0.1",
  "description": "plot programming language statistics",
  "homepage": "https://thanks2music.github.io/languish",
  "scripts": {
    "start": "bun run merge && NODE_OPTIONS=--openssl-legacy-provider cra-preact start",
    "build": "bun run merge && NODE_OPTIONS=--openssl-legacy-provider cra-preact build",
    "merge": "bun scripts/src/merge.ts > src/data.json",
    "update-data": "bun scripts/src/update-data.ts",
    "format": "prettier --write src/ scripts/src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanks2music/languish.git"
  },
  "author": "Tom",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thanks2music/languish/issues"
  },
  "devDependencies": {
    "@types/chart.js": "^2.9.16",
    "@types/murmurhash-js": "^1.0.3",
    "@types/node": "^13.9.2",
    "@types/react": "^16.9.25",
    "@types/react-dom": "^16.9.5",
    "cra-preact": "^0.4.0",
    "prettier": "^2.0.4",
    "react-scripts": "^3.4.3",
    "typescript": "^3.8.3"
  },
  "dependencies": {
    "chart.js": "^2.9.3",
    "murmurhash-js": "^1.0.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1"
  },
  "browserslist": [
    "> 5%"
  ],
  "eslintConfig": {
    "extends": "react-app"
  },
  "overrides": {
    "@types/babel__traverse": "7.11.0"
  }
}
